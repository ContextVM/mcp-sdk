{
    "name": "contextvm-mcp-workspace",
    "private": true,
    "version": "2.0.0-alpha.0",
    "description": "Model Context Protocol implementation for TypeScript",
    "license": "Apache-2.0",
    "author": "Model Context Protocol a Series of LF Projects, LLC.",
    "homepage": "https://modelcontextprotocol.io",
    "bugs": "https://github.com/modelcontextprotocol/typescript-sdk/issues",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/modelcontextprotocol/typescript-sdk.git"
    },
    "engines": {
        "node": ">=20"
    },
    "packageManager": "pnpm@10.34.5",
    "keywords": [
        "modelcontextprotocol",
        "mcp"
    ],
    "scripts": {
        "build:all": "pnpm --filter @contextvm/mcp-sdk build",
        "typecheck:all": "tsgo -p tsconfig.json --noEmit",
        "lint:all": "eslint packages scripts && prettier --check .",
        "lint:fix:all": "eslint packages scripts --fix && prettier --write .",
        "test:all": "vitest run",
        "docs:check": "node scripts/check-docs.mjs",
        "test:package": "node scripts/check-package.mjs",
        "check:all": "pnpm typecheck:all && pnpm lint:all && pnpm test:all && pnpm docs:check && pnpm test:package"
    },
    "devDependencies": {
        "@cfworker/json-schema": "catalog:runtimeShared",
        "@changesets/cli": "^2.29.8",
        "@eslint/js": "catalog:devTools",
        "@types/node": "^24.10.1",
        "@typescript/native-preview": "catalog:devTools",
        "eslint": "catalog:devTools",
        "eslint-config-prettier": "catalog:devTools",
        "prettier": "catalog:devTools",
        "tsdown": "catalog:devTools",
        "tsx": "catalog:devTools",
        "typescript": "catalog:devTools",
        "typescript-eslint": "catalog:devTools",
        "vitest": "catalog:devTools",
        "zod": "catalog:runtimeShared",
        "ajv": "catalog:runtimeShared",
        "ajv-formats": "catalog:runtimeShared",
        "json-schema-typed": "catalog:runtimeShared",
        "vite-tsconfig-paths": "catalog:devTools",
        "cross-spawn": "catalog:runtimeClientOnly",
        "@types/cross-spawn": "catalog:devTools",
        "esbuild": "^0.25.0",
        "eslint-plugin-unicorn": "^62.0.0",
        "eslint-plugin-import": "^2.32.0"
    },
    "resolutions": {
        "strip-ansi": "6.0.1"
    }
}
