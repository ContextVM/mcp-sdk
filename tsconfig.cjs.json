{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "node",
        "outDir": "./dist/cjs",
        "declaration": false,
        "declarationMap": false,
        "sourceMap": false
    },
    "include": ["src/**/*"],
    "exclude": ["**/*.test.ts", "src/__mocks__/**/*", "src/__fixtures__/**/*"]
}
